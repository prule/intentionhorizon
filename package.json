{
  "name": "intention-horizon",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Define intentions, tick them off, and watch your horizon.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright test; serenity-bdd run --destination target/site/serenity",
    "serenity-bdd:update": "serenity-bdd update",
    "gen:screenshot-data": "node scripts/generate-screenshot-data.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "dexie": "4.4.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@serenity-js/assertions": "^3.43.2",
    "@serenity-js/console-reporter": "^3.43.2",
    "@serenity-js/core": "^3.43.2",
    "@serenity-js/playwright": "^3.43.2",
    "@serenity-js/playwright-test": "^3.43.2",
    "@serenity-js/serenity-bdd": "^3.43.2",
    "@serenity-js/web": "^3.43.2",
    "@types/node": "26.1.1",
    "@types/react": "18.3.30",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "fake-indexeddb": "^6.2.5",
    "husky": "9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.8",
    "workbox-window": "7.4.1"
  },
  "packageManager": "pnpm@11.27.0+sha512.ad12821463bb143295f1fa3ecde77a6b9b97a7990386da800ff57bffc3964dc64b7b1c7559d5dbe5c337aea659ed9c8937d4370bd198ca2009bc6fa0249808e7",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": "prettier --write"
  }
}
