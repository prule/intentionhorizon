{
  "name": "intention-horizon",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Define intentions, tick them off, and watch your horizon.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright test; serenity-bdd run --destination target/site/serenity",
    "serenity-bdd:update": "serenity-bdd update",
    "gen:screenshot-data": "node scripts/generate-screenshot-data.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@serenity-js/assertions": "3.43.2",
    "@serenity-js/console-reporter": "3.43.2",
    "@serenity-js/core": "3.43.2",
    "@serenity-js/playwright": "3.43.2",
    "@serenity-js/playwright-test": "3.43.2",
    "@serenity-js/serenity-bdd": "3.43.2",
    "@serenity-js/web": "3.43.2",
    "@types/node": "26.5.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.5.1",
    "prettier": "3.9.7",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.1",
    "workbox-window": "7.4.1"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": "prettier --write"
  }
}
