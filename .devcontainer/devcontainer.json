{
  "name": "Intention Horizon",

  // JS toolchain (fnm + Node, standalone pnpm, OpenSpec CLI) is built from the
  // Dockerfile — NOT corepack, matching the Strength project's approach.
  "build": {
    "dockerfile": "Dockerfile"
  },

  // Layered on top of the built image as Dev Container Features:
  //   - java:        Serenity BDD (`serenity-bdd run`) needs a JVM.
  //   - github-cli:  `gh` for PRs/issues and HTTPS git auth (`gh auth login`).
  //   - claude-code: the Claude Code CLI.
  // Node/pnpm come from the Dockerfile, not a feature, so they stay pinned.
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "jdkDistro": "tem"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },

  // Predictable identity: --name pins the Docker container name (shown in
  // `docker ps`) and --hostname makes the shell prompt read
  // `vscode@intention-horizon`. Caveat: only ONE orchestrator may own the name
  // at a time. If a rebuild fails with "container name ... already in use",
  // remove the stale one and rebuild:  docker rm -f intention-horizon-dev
  "runArgs": ["--name", "intention-horizon-dev", "--hostname", "intention-horizon"],

  // Vite dev server + preview (this app lives at the repo ROOT).
  "forwardPorts": [5173, 4173],
  "portsAttributes": {
    "5173": { "label": "Vite dev server", "onAutoForward": "notify" },
    "4173": { "label": "Vite preview", "onAutoForward": "silent" }
  },

  // Named volumes keep heavy/machine-specific dirs off the (slow on
  // macOS/Windows) bind mount and persist across rebuilds:
  //   - node_modules : keeps host (macOS/Windows) native binaries out of the
  //     Linux container; esbuild/Playwright etc. are platform-specific. App is
  //     at the repo root, so the target is ${containerWorkspaceFolder}.
  //   - .claude      : Claude Code credentials — no re-login on rebuild.
  //     Claude also keeps account/onboarding state in ~/.claude.json, a file
  //     OUTSIDE this directory that this mount can't cover; post-create.sh
  //     symlinks it into the volume so it survives rebuilds too. Also reused
  //     to persist OpenSpec's global config (workflow profile) the same way,
  //     since it has no volume-friendly location of its own.
  //   - .config/gh   : GitHub CLI credentials, likewise.
  //   - /cache       : the pnpm store, shared with EVERY dev container on this
  //     machine, so a package version downloads once per machine. The source
  //     name is deliberately project-independent — renaming it per project
  //     silently un-shares the store. post-create points pnpm at
  //     /cache/pnpm-store; pnpm ignores env vars for that setting.
  //   - ms-playwright: the browsers, so a rebuild doesn't re-download Chromium.
  "mounts": [
    "source=intention-horizon-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=intention-horizon-claude,target=/home/vscode/.claude,type=volume",
    "source=intention-horizon-gh,target=/home/vscode/.config/gh,type=volume",
    "source=devcontainer-cache,target=/cache,type=volume",
    "source=intention-horizon-playwright,target=/home/vscode/.cache/ms-playwright,type=volume"
  ],

  // Pin Playwright to the volume above rather than its ~/.cache default
  // (containerEnv, not remoteEnv: a Playwright that can't see this var silently
  // downloads its own copy, bypassing the volume). Opt out of OpenSpec's
  // anonymous telemetry (privacy-preserving default; also silences its notice).
  // GH_CONFIG_DIR pins `gh`'s config to the mounted volume above: JetBrains
  // Gateway sets XDG_CONFIG_HOME to a path on the container's ephemeral
  // overlay (not a volume), and `gh` prefers XDG_CONFIG_HOME over its default
  // ~/.config/gh — without this override, `gh auth login` silently writes
  // somewhere that's wiped on every rebuild, defeating the volume mount.
  "containerEnv": {
    "PLAYWRIGHT_BROWSERS_PATH": "/home/vscode/.cache/ms-playwright",
    "OPENSPEC_TELEMETRY": "0",
    "GH_CONFIG_DIR": "/home/vscode/.config/gh"
  },

  // One-time provisioning: chown the volumes, sync Node to .node-version, point
  // pnpm at the shared store, install deps, and fetch the Playwright Chromium.
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "remoteUser": "vscode",

  // Editor-specific setup. VS Code reads `vscode`; JetBrains Gateway / WebStorm
  // reads `jetbrains` (and ignores the other). Both open the SAME container.
  "customizations": {
    "vscode": {
      "extensions": ["esbenp.prettier-vscode", "ms-playwright.playwright"],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    },
    "jetbrains": {
      // WebStorm is the natural fit for this React/TS/Vite frontend. Switch to
      // "IntelliJ" to use IntelliJ IDEA Ultimate instead.
      "backend": "WebStorm",
      "plugins": ["intellij.prettierJS"]
    }
  }
}
