{
  "name": "Intention Horizon",

  // Debian bookworm dev container base (non-root `vscode` user with passwordless
  // sudo, git, common CLI tooling). Node and Java are layered on as features so
  // we can pin exact versions — the prebuilt typescript-node image tops out at
  // Node 22, and this project needs Node 24 (see .node-version).
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24.18.0"
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "jdkDistro": "tem"
    },
    // GitHub CLI — used to authenticate git over HTTPS (`gh auth login`).
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Static, predictable container name. `docker ps` / `docker exec` /
  // IDE attach all see it as "intention-horizon-dev" on every rebuild.
  // Note: only one instance can exist at a time — rebuilding replaces it.
  "runArgs": ["--name", "intention-horizon-dev"],

  // Keep node_modules in a named volume rather than the bind-mounted workspace.
  // esbuild, Playwright and other native binaries are platform-specific, so the
  // host's (macOS/Windows) node_modules must not leak into the Linux container.
  // Named volumes survive container rebuilds, so logins persist:
  //   - node_modules : keeps host (macOS/Windows) native binaries out of the
  //     Linux container; esbuild/Playwright etc. are platform-specific.
  //   - .claude      : Claude Code credentials, so you don't re-login on rebuild.
  //   - .config/gh   : GitHub CLI credentials, likewise.
  //   - /cache       : the pnpm store, shared with EVERY dev container on this
  //     machine, so a package version is downloaded once per machine rather than
  //     once per project. The source name is deliberately project-independent —
  //     renaming it per project silently un-shares the store. post-create points
  //     pnpm at /cache/pnpm-store; pnpm ignores env vars for that setting, so it
  //     cannot be configured here.
  //   - ms-playwright: the browsers, so a rebuild doesn't re-download ~539MB.
  //     Per project on purpose — a shared browser cache lets one project's
  //     `playwright install` garbage-collect another project's browsers.
  "mounts": [
    "source=intention-horizon-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=intention-horizon-claude,target=/home/vscode/.claude,type=volume",
    "source=intention-horizon-gh,target=/home/vscode/.config/gh,type=volume",
    "source=devcontainer-cache,target=/cache,type=volume",
    "source=intention-horizon-playwright,target=/home/vscode/.cache/ms-playwright,type=volume"
  ],

  // Pin Playwright to the volume above rather than relying on its ~/.cache
  // default. containerEnv, not remoteEnv: remoteEnv only reaches processes the
  // dev container tooling launches, and a Playwright that cannot see this var
  // doesn't fail — it silently downloads its own copy, bypassing the volume.
  "containerEnv": {
    "PLAYWRIGHT_BROWSERS_PATH": "/home/vscode/.cache/ms-playwright"
  },

  "forwardPorts": [5173, 4173],
  "portsAttributes": {
    "5173": { "label": "Vite dev server", "onAutoForward": "notify" },
    "4173": { "label": "Vite preview", "onAutoForward": "silent" }
  },

  // First-create setup: pnpm (pinned), workflow CLIs, deps, Chromium. See script.
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "remoteUser": "vscode",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-playwright.playwright",
        "anthropic.claude-code"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
